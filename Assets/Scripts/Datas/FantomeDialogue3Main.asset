  rows:
  - rowNumber: 0
    charactereName: 
    longDialogueText: '*Voix*'
    nextRowNumber: 1
  - rowNumber: 1
    charactereName: Ava
    longDialogueText: "Pourquoi j\u2019ai l\u2019impression que quelqu\u2019un me
      parle ?"
    nextRowNumber: 2
  - rowNumber: 2
    charactereName: Ava
    longDialogueText: "Qui est l\xE0 ?!\nMontre-toi !"
    nextRowNumber: 3
  - rowNumber: 3
    charactereName: "Fant\xF4me"
    longDialogueText: BOUH !
    nextRowNumber: 4
  - rowNumber: 4
    charactereName: "Fant\xF4me"
    longDialogueText: Tu n'a pas peur de moi ? Ce n'ai pas commun.
    nextRowNumber: 5
  - rowNumber: 5
    charactereName: Ava
    longDialogueText: Un peu...mais je dois continuer a avancer...
    nextRowNumber: -1
  - rowNumber: 6
    charactereName: Ava
    longDialogueText: AAAH !
    nextRowNumber: 7
  - rowNumber: 7
    charactereName: "Fant\xF4me"
    longDialogueText: Hahaha ! Je t'ai eu ! si tu continue d'avoir peur comme ca
      te n'avancera jamais.
    nextRowNumber: -1
