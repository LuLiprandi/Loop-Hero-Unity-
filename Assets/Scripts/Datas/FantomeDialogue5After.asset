  rows:
  - rowNumber: 0
    charactereName: "Fant\xF4me"
    longDialogueText: "Tu avances m\xEAme fatigu\xE9e\u2026 c\u2019est rare."
    nextRowNumber: 1
  - rowNumber: 1
    charactereName: Ava
    longDialogueText: "Je n\u2019ai pas le choix."
    nextRowNumber: 2
  - rowNumber: 2
    charactereName: "Fant\xF4me"
    longDialogueText: Si. Tu as choisi de continuer.
    nextRowNumber: -1
  - rowNumber: 3
    charactereName: "Fant\xF4me"
    longDialogueText: "Tu es encore l\xE0\u2026 malgr\xE9 ton \u201Cj\u2019en peux
      plus\u201D."
    nextRowNumber: 4
  - rowNumber: 4
    charactereName: Ava
    longDialogueText: "Je pensais que j\u2019allais craquer."
    nextRowNumber: 5
  - rowNumber: 5
    charactereName: "Fant\xF4me"
    longDialogueText: Fais attention. La fatigue fait tomber sans bruit.
    nextRowNumber: -1
