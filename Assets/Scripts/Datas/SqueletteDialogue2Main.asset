  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a57068bf627ccf8489974b3146ae6144, type: 3}
  m_Name: SqueletteDialogue2Main
  m_EditorClassIdentifier: 
  rows:
  - rowNumber: 0
    charactereName: Squelette
    longDialogueText: "Clac\u2026 clac\u2026 Tu n\u2019as rien \xE0 faire ici petite.
      Tu marches vite."
    nextRowNumber: 1
  - rowNumber: 1
    charactereName: Ava
    longDialogueText: "Je\u2026 je cherche de l\u2019aide. Je ne veux pas d\u2019ennuis...
      Je veux sortir de cette for\xEAt."
    nextRowNumber: 2
  - rowNumber: 2
    charactereName: Ava
    longDialogueText: "S\u2019il te pla\xEEt\u2026 tu sais comment aller a ce manoir
      ?"
    nextRowNumber: 3
  - rowNumber: 3
    charactereName: Squelette
    longDialogueText: Oui. C'est tout droit mais attention... Plus tu fuis, plus
      les arbres se rapprochent.
    nextRowNumber: -1
  - rowNumber: 4
    charactereName: Ava
    longDialogueText: Je dois continuer a marcher vite...
    nextRowNumber: 5
  - rowNumber: 5
    charactereName: Squelette
    longDialogueText: "Ceux qui observent \xE9vitent les pi\xE8ges."
    nextRowNumber: 6
  - rowNumber: 5
    charactereName: Squelette
    longDialogueText: La peur confond vitesse et survie.
    nextRowNumber: -1
