  - rowNumber: 2
    charactereName: "Fant\xF4me"
    longDialogueText: "Oui. Mais tu n\u2019es plus perdue."
    nextRowNumber: 3
  - rowNumber: 3
    charactereName: Ava
    longDialogueText: "J\u2019avance malgr\xE9 la peur."
    nextRowNumber: 4
  - rowNumber: 4
    charactereName: "Fant\xF4me"
    longDialogueText: "Alors tu es pr\xEAte pour la suite."
    nextRowNumber: -1
  - rowNumber: 5
